# Copy this file to .env and fill in your values
# Never commit .env to git

ANTHROPIC_API_KEY=sk-ant-...

# Notion integration token (from notion.so/my-integrations)
NOTION_API_KEY=secret_...

# NEXUS File Catalog database ID (pre-filled — only change if you recreate the DB)
FILE_CATALOG_DB_ID=9b6cec19-5e88-4369-ba46-d90283d4c61e

# Ollama (default port)
OLLAMA_API_URL=http://localhost:11434

# Memory
MEM0_API_KEY=                  # leave blank for local mode
AGENT_USER_ID=kenneth          # unique ID for your mem0 memory space

# Intake folders — semicolon-separated Windows paths to scan for new files
# Example: C:\Users\Allen Watts\Pictures;C:\Users\Allen Watts\Downloads
INTAKE_FOLDERS=C:\Users\Allen Watts\Pictures

# Batch size and confidence threshold
INTAKE_BATCH_SIZE=15
AUTO_SUGGEST_THRESHOLD=0.90
