# Copy this file to .env and fill in your values
# Never commit .env to git

ANTHROPIC_API_KEY=sk-ant-...

# Eagle API (default port, change if different)
EAGLE_API_URL=http://localhost:41595

# Ollama (default port)
OLLAMA_API_URL=http://localhost:11434

# Memory
MEM0_API_KEY=                  # leave blank for local mode
AGENT_USER_ID=kenneth          # unique ID for your mem0 memory space

# Batch size for Eagle intake review
INTAKE_BATCH_SIZE=15

# Confidence threshold for auto-suggest (still requires approval)
AUTO_SUGGEST_THRESHOLD=0.90
