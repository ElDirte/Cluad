# Second Brain — Environment Configuration
# Copy to .env and fill in your values

# Vault root (set by init.sh, override if needed)
VAULT_ROOT=~/SecondBrain

# Anthropic API (shared with Cluad agent)
ANTHROPIC_API_KEY=sk-ant-...

# Ollama (local LLM for tagging — no cost)
OLLAMA_URL=http://localhost:11434
OLLAMA_TAG_MODEL=llama3.2:3b
OLLAMA_VISION_MODEL=llava:7b

# Neo4j
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=changeme

# Notion (optional — for public-facing mirror)
NOTION_TOKEN=
NOTION_DATABASE_ID=

# n8n (orchestration)
N8N_URL=http://localhost:5678

# Eagle (existing Cluad integration)
EAGLE_API_URL=http://localhost:41595

# Intake sources
CLAUDE_SESSIONS_DIR=~/.claude/projects
GMAIL_EXPORT_DIR=~/Downloads/gmail-exports
TRANSCRIPT_DROP_DIR=~/Downloads/transcripts

# Tagging thresholds (0.0–1.0)
AUTO_APPLY_THRESHOLD=0.90
REVIEW_THRESHOLD=0.70
FLAG_THRESHOLD=0.50

# Agent identity
AGENT_USER_ID=kenneth
