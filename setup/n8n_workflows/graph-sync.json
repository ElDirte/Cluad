{
  "name": "Second Brain — Graph Sync (Neo4j)",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "cronExpression",
              "expression": "0 2 * * *"
            }
          ]
        }
      },
      "id": "c3d4e5f6-0003-0003-0003-000000000001",
      "name": "Daily at 2am",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.1,
      "position": [200, 300]
    },
    {
      "parameters": {
        "method": "GET",
        "url": "http://host.docker.internal:8001/health",
        "options": { "timeout": 5000 }
      },
      "id": "c3d4e5f6-0003-0003-0003-000000000002",
      "name": "Check API Health",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.1,
      "position": [420, 300]
    },
    {
      "parameters": {
        "conditions": {
          "options": { "caseSensitive": true, "leftValue": "", "typeValidation": "strict" },
          "conditions": [
            {
              "id": "check-vault",
              "leftValue": "={{ $json.vault_exists }}",
              "rightValue": true,
              "operator": { "type": "boolean", "operation": "equals" }
            }
          ],
          "combinator": "and"
        }
      },
      "id": "c3d4e5f6-0003-0003-0003-000000000003",
      "name": "Vault Ready?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [640, 300]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "http://host.docker.internal:8001/sync",
        "options": { "timeout": 300000 }
      },
      "id": "c3d4e5f6-0003-0003-0003-000000000004",
      "name": "Run Graph Sync",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.1,
      "position": [860, 220]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "http://host.docker.internal:8001/snapshot",
        "options": { "timeout": 30000 }
      },
      "id": "c3d4e5f6-0003-0003-0003-000000000005",
      "name": "Git Snapshot",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.1,
      "position": [1080, 220]
    }
  ],
  "connections": {
    "Daily at 2am": {
      "main": [[{ "node": "Check API Health", "type": "main", "index": 0 }]]
    },
    "Check API Health": {
      "main": [[{ "node": "Vault Ready?", "type": "main", "index": 0 }]]
    },
    "Vault Ready?": {
      "main": [
        [{ "node": "Run Graph Sync", "type": "main", "index": 0 }],
        []
      ]
    },
    "Run Graph Sync": {
      "main": [[{ "node": "Git Snapshot", "type": "main", "index": 0 }]]
    }
  },
  "active": false,
  "settings": { "executionOrder": "v1" },
  "tags": [{ "name": "second-brain" }],
  "meta": { "templateCredsSetupCompleted": true }
}
